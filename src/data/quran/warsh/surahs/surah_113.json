{
    "index": "113",
    "name": "Al-Falaq",
    "verse": {
        "verse_1": "قُلَ اَعُوذُ بِرَبِّ اِ۬لْفَلَقِ",
        "verse_2": "مِن شَرِّ مَا خَلَقَ",
        "verse_3": "وَمِن شَرِّ غَاسِقٍ اِذَا وَقَبَ",
        "verse_4": "وَمِن شَرِّ اِ۬لنَّفَّٰثَٰتِ فِے اِ۬لْعُقَدِ",
        "verse_5": "وَمِن شَرِّ حَاسِدٍ اِذَا حَسَدَۖ"
    },
