    "name": "An-Nas",
    "verse": {
        "verse_1": "قُلَ اَعُوذُ بِرَبِّ اِ۬لنَّاسِ",
        "verse_2": "مَلِكِ اِ۬لنَّاسِ",
        "verse_3": "إِلَٰهِ اِ۬لنَّاسِ",
        "verse_4": "مِن شَرِّ اِ۬لْوَسْوَاسِ اِ۬لْخَنَّاسِ",
        "verse_5": "اِ۬لذِے يُوَسْوِسُ فِے صُدُورِ اِ۬لنَّاسِ",
        "verse_6": "مِنَ اَ۬لْجِنَّةِ وَالنَّاسِۖ"
    },
